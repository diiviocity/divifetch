#!/usr/bin/env -S v run

// build.vsh — generated by the divifetch-zig generator (edit build.conf instead).

import x.imp
import os

const build_dir = 'target'
const target_exe = os.join_path_single(build_dir, 'divifetch')
const zig = 'zig'
const zig_flags = '-Doptimize=ReleaseFast -fstrip'
const headgen_file = '.tmp/headgen.zig'
const headgen_exe = os.join_path_single(build_dir, 'headgen')
const dest_dir = '/usr/local/bin'
const install_path = '/usr/local/bin/divifetch'
const c_sources = []string{}
const objects = []string{}
const compile_steps = [][]string{}
const compile_shells = []string{}
const rust_ext = [][]string{}
const extra_link = []string{}
const v_bakes = [][]string{}


// the generated V fetch program's whole source directory.
const v_src_dir = '.tmp/vfetch'
const v_modules = [['user', 'modules/v/user'], ['hostname', 'modules/v/hostname'], ['kernel', 'modules/v/kernel'], ['uptime', 'modules/v/uptime'], ['distro', 'modules/v/distro'], ['battery', 'modules/v/battery'], ['boot', 'modules/v/boot'], ['cpu', 'modules/v/cpu'], ['monitor', 'modules/v/monitor'], ['host', 'modules/v/host'], ['loadavg', 'modules/v/loadavg'], ['memory', 'modules/v/memory'], ['mount', 'modules/v/mount'], ['packages', 'modules/v/packages'], ['pid1', 'modules/v/pid1'], ['shell', 'modules/v/shell'], ['swap', 'modules/v/swap'], ['temp', 'modules/v/temp'], ['terminal', 'modules/v/terminal'], ['font', 'modules/v/font'], ['vpn', 'modules/v/vpn'], ['wm', 'modules/v/wm'], ['hello_world', 'modules/v/hello_world']]

// v_alias points one module symlink beside the generated source at
// its module tree: a real directory breaks the build loudly, and a
// symlink of another age re-points fresh — the link rides an absolute
// path, like the modules alias the zig build grew.
fn v_alias(mod_dir string, name string, dir string) ! {
	alias := os.join_path_single(mod_dir, name)
	if os.is_dir(alias) && !os.is_link(alias) {
		return error('the module ' + alias + ' is a real directory; the fetch needs it as a symlink into the repo tree')
	}
	if os.is_link(alias) {
		os.rm(alias)!
	}
	if os.is_dir(alias) {
		return
	}
	os.symlink(os.abs_path(dir), alias)!
}
mut ctx := imp.new()

ctx.default(['build'])

ctx.add_target(target_exe)

mut regen_args := ['v', 'run', 'generator', '-S', '-os', '.tmp/vfetch/run.v', '-ohg', '.tmp/headgen.zig', '-oh', '.tmp/vfetch/bake.v', '-orun', '.tmp/vfetch-run/run-run.v', '-s', 'config.lip']

ctx.add_flow(
	id: 'regen'
	help: 'regenerate run.zig and headgen.zig from the lips'
	takes: ['config.lip', 'modules']
	gives: ['.tmp/vfetch/run.v']
	flow: fn [regen_args] (self imp.Flow) ! {
		imp.system_args(regen_args)!
		if os.exists('.tmp/vfetch-run/run-run.v') {
			os.rm('.tmp/vfetch-run/run-run.v')!
		}
		mut stale := os.join_path_single('target', 'divifetch-run')
		if os.exists(stale) { os.rm(stale)! }
		imp.system_args(regen_args)!
	}
)

ctx.add_flow(
	id: 'build'
	help: 'bake what headgen says and the V entries print, and compile the fetch'
	takes: ['.tmp/vfetch/run.v', 'modules']
	gives: [target_exe]
	flow: fn (self imp.Flow) ! {
		os.mkdir_all('.tmp/vfetch')!
		os.mkdir_all(build_dir)!
		// the generated V source reaches its modules through one
		// symlink per module — the imports beside the sources answer.
		for pair in v_modules {
			v_alias(v_src_dir, pair[0], pair[1])!
		}
		// the compiled-language modules build their objects first: the
		// rust staticlibs, the dmd objects, and any template command the
		// lips carried.
		for step in compile_steps {
			imp.system_args(step)!
		}
		// the extern-dep rust modules: each module dir carries the
		// manifest cargo grew from the lip, its staticlib lands inside
		// its own target/, and the archive rides the modules tree for
		// the objects const.
		for pair in rust_ext {
			name := pair[0]
			base_file := pair[2].all_before_last('.')
			mut manifest := pair[1]
			manifest += '/Cargo.toml'
			imp.system_args(['cargo', 'build', '--release', '--manifest-path', manifest])!
			mut out_a := pair[1]
			out_a += '/target/release/lib'
			out_a += name
			out_a += '.a'
			mut target_a := pair[1]
			target_a += '/'
			target_a += base_file + '.a'
			os.cp(out_a, target_a)!
		}
		for cmd in compile_shells {
			code := os.system_args(['/bin/sh', '-c', cmd])
			if code != 0 {
				return error('a compile step failed: ' + cmd + ' (code ' + code.str() + ')')
			}
		}
		// build-time entries bake here once: headgen runs the zig, c, cpp
		// and rust ones, the v_bakes steps run the V ones, and their
		// output lands in the bake file the fetch imports.
		mut bake_out := ''
		// the V bake file is its own module file: the consts sit in the
		// same directory the sources compile from.
		bake_out = '// bake.v — generated by build.vsh: one baked value per build-time entry.
module main
'
		os.write_file('.tmp/vfetch/bake.v', bake_out)!
		// the fetch compiles v-style: the whole source dir answers — its
		// run.v entry, its bake const file, its module symlink dirs.
		imp.system_args(['v', '-prod', '-o', target_exe, v_src_dir])!
	}
)

ctx.add_flow(
	id: 'clean'
	help: 'delete the build directory and the bake file'
	check: imp.Check.none
	flow: fn (self imp.Flow) ! {
		mut swept := []string{}
		swept << build_dir
		swept << '.tmp/vfetch/bake.v'
		for path in swept {
			if !os.is_dir(path) && os.exists(path) {
				os.rm(path)!
			} else if os.is_dir(path) {
				os.rmdir_all(path)!
			}
		}
	}
)

ctx.add_flow(
	id: 'install'
	help: 'install the fetch to ' + dest_dir
	takes: [target_exe]
	gives: [install_path]
	flow: fn (self imp.Flow) ! {
		os.mkdir_all(dest_dir)!
		imp.system_args(['install', '-Dm755', target_exe, install_path])!
	}
)

ctx.add_flow(
	id: 'uninstall'
	help: 'uninstall the fetch from ' + dest_dir
	check: imp.Check.none
	flow: fn (self imp.Flow) ! {
		imp.system_args(['rm', '-f', install_path])!
	}
)

ctx.add_auto_flow(.run)

ctx.flow()
