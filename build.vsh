#!/usr/bin/env -S v run

// build.vsh — generated by the divifetch-zig generator (edit build.conf instead).

import x.imp
import os

const build_dir = 'target'
const target_exe = os.join_path_single(build_dir, 'divifetch')
const zig = 'zig'
const zig_flags = '-Doptimize=ReleaseFast -fstrip'
const headgen_file = '.tmp/headgen.zig'
const headgen_exe = os.join_path_single(build_dir, 'headgen')
const dest_dir = '/usr/local/bin'
const install_path = '/usr/local/bin/divifetch'
const c_sources = []string{}
const objects = []string{}
const compile_steps = [][]string{}
const compile_shells = []string{}
const rust_ext = [][]string{}
const extra_link = []string{}
const v_bakes = [][]string{}

mut ctx := imp.new()

ctx.default(['build'])

ctx.add_target(target_exe)

mut regen_args := ['v', 'run', 'generator', '-S', '-os', '.tmp/run.zig', '-ohg', '.tmp/headgen.zig', '-oh', '.tmp/bake.zig', '-orun', '.tmp/run-run.zig', '-s', 'config.lip']

ctx.add_flow(
	id: 'regen'
	help: 'regenerate run.zig and headgen.zig from the lips'
	takes: ['config.lip', 'modules']
	gives: ['.tmp/run.zig']
	flow: fn [regen_args] (self imp.Flow) ! {
		imp.system_args(regen_args)!
		if os.exists('.tmp/run-run.zig') {
			os.rm('.tmp/run-run.zig')!
		}
		mut stale := os.join_path_single('target', 'divifetch-run')
		if os.exists(stale) { os.rm(stale)! }
		imp.system_args(regen_args)!
	}
)

ctx.add_flow(
	id: 'build'
	help: 'bake what headgen says and the V entries print, and compile the fetch'
	takes: ['.tmp/run.zig', 'modules']
	gives: [target_exe]
	flow: fn (self imp.Flow) ! {
		os.mkdir_all('.tmp')!
		os.mkdir_all(build_dir)!
		// the generated sources reach the modules through a tree symlink
		mod_alias := os.join_path_single('.tmp', 'modules')
		if os.is_dir(mod_alias) && !os.is_link(mod_alias) {
			return error('the modules ' + mod_alias + ' is a real directory; the fetch needs it as a symlink into the repo tree')
		}
		// a symlink of another age — the workspace having moved — re-points
		// fresh: the alias rides an absolute path.
		if os.is_link(mod_alias) {
			os.rm(mod_alias)!
		}
		if !os.exists(mod_alias) {
			os.symlink(os.abs_path('modules'), mod_alias)!
		}
		// the compiled-language modules build their objects first: the
		// rust staticlibs, the dmd objects, and any template command the
		// lips carried.
		for step in compile_steps {
			imp.system_args(step)!
		}
		// the extern-dep rust modules: each module dir carries the
		// manifest cargo grew from the lip, its staticlib lands inside
		// its own target/, and the archive rides the modules tree for
		// the objects const.
		for pair in rust_ext {
			name := pair[0]
			base_file := pair[2].all_before_last('.')
			mut manifest := pair[1]
			manifest += '/Cargo.toml'
			imp.system_args(['cargo', 'build', '--release', '--manifest-path', manifest])!
			mut out_a := pair[1]
			out_a += '/target/release/lib'
			out_a += name
			out_a += '.a'
			mut target_a := pair[1]
			target_a += '/'
			target_a += base_file + '.a'
			os.cp(out_a, target_a)!
		}
		for cmd in compile_shells {
			code := os.system_args(['/bin/sh', '-c', cmd])
			if code != 0 {
				return error('a compile step failed: ' + cmd + ' (code ' + code.str() + ')')
			}
		}
		// build-time entries bake here once: headgen runs the zig, c, cpp
		// and rust ones, the v_bakes steps run the V ones, and their
		// output lands in the bake file run.zig imports.
		mut bake_out := ''
		if os.exists(headgen_file) {
			mut argv := [zig, 'build-exe']
			argv << zig_flags.split(' ')
			argv << [headgen_file]
			argv << c_sources
			argv << objects
			argv << extra_link
			argv << ['-femit-bin=' + headgen_exe]
			imp.system_args(argv)!
			bake := os.exec([headgen_exe])
			if bake.exit_code != 0 {
				print(bake.output)
				return error('headgen exited with ' + bake.exit_code.str())
			}
			bake_out += bake.output
		}
		os.write_file('.tmp/bake.zig', bake_out)!
		mut argv := [zig, 'build-exe']
		argv << zig_flags.split(' ')
		argv << ['.tmp/run.zig']
		argv << c_sources
		argv << objects
		argv << extra_link
		argv << ['-femit-bin=' + target_exe]
		imp.system_args(argv)!
	}
)

ctx.add_flow(
	id: 'clean'
	help: 'delete the build directory and the bake file'
	check: imp.Check.none
	flow: fn (self imp.Flow) ! {
		mut swept := []string{}
		swept << build_dir
		swept << '.tmp/bake.zig'
		for path in swept {
			if !os.is_dir(path) && os.exists(path) {
				os.rm(path)!
			} else if os.is_dir(path) {
				os.rmdir_all(path)!
			}
		}
	}
)

ctx.add_flow(
	id: 'install'
	help: 'install the fetch to ' + dest_dir
	takes: [target_exe]
	gives: [install_path]
	flow: fn (self imp.Flow) ! {
		os.mkdir_all(dest_dir)!
		imp.system_args(['install', '-Dm755', target_exe, install_path])!
	}
)

ctx.add_flow(
	id: 'uninstall'
	help: 'uninstall the fetch from ' + dest_dir
	check: imp.Check.none
	flow: fn (self imp.Flow) ! {
		imp.system_args(['rm', '-f', install_path])!
	}
)

ctx.add_auto_flow(.run)

ctx.flow()
